# ============================================================
# 应用基础配置
# ============================================================

# 访问域名，如 https://example.com
APP_URL=http://localhost:3000
# 监听端口
PORT=3000
# 应用密钥（至少 32 字符），生成命令：openssl rand -hex 32
APP_SECRET=e0888f9c8c976c37b000634bf8e3e9cac2f844a23c7790ef76f9804d52af34ab
# JWT 令牌过期时间
JWT_TOKEN_EXPIRES_IN=30d

# ============================================================
# 数据库与缓存
# ============================================================

# PostgreSQL 连接地址
DATABASE_URL="postgresql://postgres:a158614924@192.168.16.11:5432/docmost?schema=public"
# Redis 连接地址
REDIS_URL=redis://:158614924@192.168.16.215:6379

# ============================================================
# 文件存储
# ============================================================

# 存储驱动：local（本地） | s3（对象存储）
STORAGE_DRIVER=local
# 文件上传大小限制（默认 50mb）
FILE_UPLOAD_SIZE_LIMIT=

# S3 对象存储配置（仅 STORAGE_DRIVER=s3 时需要）
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# ============================================================
# 邮件配置
# ============================================================

# 邮件驱动：smtp | postmark
MAIL_DRIVER=smtp
# 发件人地址
MAIL_FROM_ADDRESS=hello@example.com
# 发件人名称
MAIL_FROM_NAME=FORCOME知识库

# SMTP 配置
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 是否启用 TLS 加密
SMTP_SECURE=false
# 是否忽略 TLS（不推荐）
SMTP_IGNORETLS=false

# Postmark 配置
POSTMARK_TOKEN=

# ============================================================
# AI 模型配置（多模型分级）
# ============================================================

# AI 驱动：openai | openai-compatible | gemini | ollama
AI_DRIVER=openai-compatible
# API 地址（openai / openai-compatible 时需要）
OPENAI_API_URL=http://74.211.105.94:3008/v1
# API 密钥
OPENAI_API_KEY=sk-k1bTuIu2xK8chosCMC1hPmv0tD1xnAqb38pApra7RkDizFMP

# --- 主模型：AI 创作面板、RAG 问答 ---
AI_COMPLETION_MODEL=gpt-5.2

# --- 轻量模型：上下文前缀生成、LLM rerank（未配置时回退到主模型） ---
AI_LITE_MODEL=gpt-5-mini

# --- 视觉模型：图片描述 VLM（未配置时回退到主模型） ---
AI_VLM_MODEL=gemini-3-flash-preview
# VLM 专用驱动（未配置时回退到 AI_DRIVER，当前统一走代理无需设置）
# AI_VLM_DRIVER=gemini

# --- 向量嵌入模型 ---
AI_EMBEDDING_MODEL=text-embedding-3-small
# 嵌入维度
AI_EMBEDDING_DIMENSION=1536

# --- 专用 Rerank 模型（可选，未配置时使用 LLM rerank） ---
AI_RERANK_MODEL=gpt-5-nano
AI_RERANK_API_URL=http://74.211.105.94:3008/v1

# ============================================================
# Wiki 公开 API
# ============================================================

# 公开给 Wiki 前端的空间 slug 列表（逗号分隔）
# 留空 = 公开所有空间；填值 = 白名单模式（只公开指定空间）
WIKI_PUBLIC_SPACE_SLUGS=
# Wiki 前端地址
WIKI_URL=http://localhost:5175
VITE_WIKI_URL=http://localhost:5175

# ============================================================
# 钉钉 SSO 单点登录（企业内部应用）
# ============================================================

DINGTALK_CORP_ID=ding6d2fade9c8059d3b35c2f4657eb6378f
DINGTALK_APP_KEY=dingm5wrrpgmqzxvq1nd
DINGTALK_APP_SECRET=xIAhHVXHYeWBKlWy_bmUhTSxhQ3loxfjengMXj-37-0n8u3YIO3gFYx4kigqu_KJ
DINGTALK_AGENT_ID=4297556224

# ============================================================
# 其他
# ============================================================

# 自定义 Draw.io 服务器地址
DRAWIO_URL=
# 关闭遥测数据上报
DISABLE_TELEMETRY=false
# 生产环境调试日志
DEBUG_MODE=false
# 打印数据库查询
DEBUG_DB=false
# 打印 HTTP 请求
LOG_HTTP=false

# ============================================================
# AI Agent 智能体服务
# ============================================================

# Agent 服务地址（Docker 内网）
AGENT_SERVICE_URL=http://agent-service:8100
# Agent 内部通信密钥（NestJS ↔ Agent Service 双向认证）
AGENT_INTERNAL_SECRET=a9f3c7e1d4b8526a0e7f9d3c1b5a8e2f4d6c0b9a7e5f3d1c

# --- Agent LLM 覆盖配置（可选，留空则复用上方 AI_* 配置） ---
# AGENT_LLM_PROVIDER=
# AGENT_LLM_MODEL=
# AGENT_LLM_API_KEY=
# AGENT_LLM_API_URL=

# --- 图片生成（OpenAI 兼容格式，复用 OPENAI_API_KEY 认证） ---
AGENT_IMAGE_API_URL=https://api.forcome.com/v1
AGENT_IMAGE_MODEL=gemini-3-pro-image-preview

# --- 搜索与爬虫工具 ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# 自部署 Firecrawl 地址（默认 https://api.firecrawl.dev）
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# --- 运行配置 ---
# Plan-Execute-Review 最大循环次数（默认 3）
# AGENT_MAX_ITERATIONS=3
